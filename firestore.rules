// =====================================================================
//  РЕКОМЕНДОВАНІ ПРАВИЛА БЕЗПЕКИ FIRESTORE ДЛЯ Fjord
// =====================================================================
// Куди вставити: Firebase Console → Firestore Database → Rules → замінити
// вміст на це → Publish.
//
// Навіщо: за замовчуванням (або в "test mode") Firestore дозволяє БУДЬ-
// КОМУ читати й писати ВСІ документи. Ваш код зберігає весь прогрес
// користувача (users/{uid}) через saveToFirestore(uid, STATE) — без
// правил нижче будь-який автентифікований (а іноді й неавтентифікований)
// відвідувач міг би прочитати або переписати чужий прогрес.
//
// Ці правила дозволяють користувачу читати/писати ТІЛЬКИ свій власний
// документ users/{uid}, де {uid} збігається з його Firebase Auth UID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Допоміжна перевірка: чи автентифікований користувач — адмін
    // (дивиться його ж власний документ users/{uid}).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    match /users/{uid} {
      // Читати свій документ може кожен; адмін додатково може читати
      // документи інших користувачів (потрібно для розділу
      // "Користувачі" в адмін-панелі).
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      // Дозволяємо створення власного документа, але НЕ дозволяємо одразу
      // виставити собі admin: true.
      allow create: if request.auth != null && request.auth.uid == uid &&
        (!('admin' in request.resource.data) || request.resource.data.admin == false);
      // Оновлення: звичайний користувач може оновлювати СВІЙ документ, але
      // не може сам собі змінити admin. Адміністратор (isAdmin()) може
      // оновлювати БУДЬ-чий документ, включно з зміною поля admin —
      // це потрібно для кнопки "Зробити адміном/Прибрати адміна" у
      // розділі "Користувачі" адмін-панелі.
      // ВАЖЛИВО: порівнюємо через .get('admin', false), а НЕ напряму
      // .data.admin — якщо в документі взагалі немає поля admin (а так
      // було з усіма, хто зареєструвався до цього фіксу), пряме звернення
      // resource.data.admin падає з помилкою "undefined property" і
      // Firestore трактує це як permission-denied. Тобто буквально КОЖЕН
      // виклик updateState()/saveToFirestore() для звичайного користувача
      // без явного поля admin у документі — відхилявся мовчки. Це і була
      // причина "результати й користувачі не зберігаються": не лише
      // прогрес користувача, а й усе, що з ним пов'язано, просто ніколи
      // не записувалось у Firestore.
      allow update: if request.auth != null && (
        (request.auth.uid == uid &&
          request.resource.data.get('admin', false) == resource.data.get('admin', false)) ||
        isAdmin()
      );
    }
    // Спільні словники (генеруються в адмін-панелі): читати може будь-хто
    // (навіть гості — це просто навчальний контент, не приватні дані), а
    // писати/публікувати — лише користувач, чий власний документ users/{uid}
    // має admin: true.
    match /sharedVocab/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Спільна граматика (генерується в адмін-панелі, той самий принцип, що
    // й sharedVocab вище): читати може будь-хто, публікувати — лише адмін.
    match /sharedGrammar/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Книги (текст вставляє вручну адмін, суспільне надбання) — той самий
    // принцип: читати може будь-хто, публікувати/редагувати/видаляти — лише адмін.
    match /sharedBooks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Слова (окрема колекція, яку читає й наповнює адмін-панель) — той
    // самий принцип: читати може будь-хто, писати лише адмін.
    match /words/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Турніри — публічно видимі всім (таблиця лідерів, список активних
    // турнірів), але створювати/редагувати може лише адмін.
    // УВАГА: це лише опис/налаштування турніру. Якщо додаватимете подання
    // результатів гравцями — НЕ дозволяйте писати в цей самий документ
    // напряму з клієнта (інакше будь-хто підробить собі результат);
    // рахунки мають рахуватись на довіреному бекенді (Cloud Function),
    // а не прийматись від клієнта як готове число.
    match /tournaments/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // Подання результату гравцем: окремий документ на кожного
      // учасника (id документа = його власний uid), а не поле в самому
      // турнірі — так Firestore-правила можуть просто перевірити "чи це
      // твій власний документ", без ризику, що хтось перепише результат
      // іншого гравця чи сам турнір.
      // ЧЕСНО: рахунок (score) все одно рахує й надсилає сам клієнт —
      // технічно підкований гравець може його підробити через DevTools.
      // Це прийнятний рівень довіри для навчального застосунку без
      // грошових призів, але якщо колись зробите реальні призи чи
      // офіційний рейтинг — рахунок треба буде переносити на бекенд
      // (Cloud Function, яка сама перевіряє відповіді).
      match /participants/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Завдання дня — так само: всі бачать сьогоднішнє завдання, редагує
    // лише адмін.
    match /daily_tasks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Слово дня (адмінська підбірка, перекриває автоматичний вибір) —
    // той самий принцип.
    match /daily_words/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Явна заборона на все інше (без цього блоку Firestore і так
    // забороняє за замовчуванням шляхи, не описані вище, але залишаємо
    // явно для читабельності).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
